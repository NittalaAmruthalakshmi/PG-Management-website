<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>PG Manager</title>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;700&family=Figtree:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#f1f3f8;--surface:#fff;--ink:#18203a;--mute:#66708a;--line:#dde2ee;--side:#1b2540;--side-ink:#c5cde4;--brand:#2f6bff;--brand-soft:#e1eaff;--ok:#1f9d63;--ok-soft:#dcf3e8;--bad:#d6453d;--bad-soft:#fbe1df;--warn:#e0a21b;--warn-soft:#fbefcf;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px);color-scheme:light}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0e1424;--surface:#161e33;--ink:#e7ecf8;--mute:#92a0bf;--line:#26304b;--side:#0a0f1d;--brand:#6f9bff;--brand-soft:#1b2a55;--ok:#4ccb90;--ok-soft:#14372a;--bad:#ff7d74;--bad-soft:#40201f;--warn-soft:#41330f;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#0e1424;--surface:#161e33;--ink:#e7ecf8;--mute:#92a0bf;--line:#26304b;--side:#0a0f1d;--brand:#6f9bff;--brand-soft:#1b2a55;--ok:#4ccb90;--ok-soft:#14372a;--bad:#ff7d74;--bad-soft:#40201f;--warn-soft:#41330f;color-scheme:dark}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:400 15px/1.5 Figtree,system-ui,-apple-system,"Segoe UI",sans-serif}
h1,h2,h3{font-family:Sora,Figtree,system-ui,sans-serif;margin:0;letter-spacing:-.01em}
.app{display:grid;grid-template-columns:230px 1fr;min-height:100vh}
aside{background:var(--side);color:var(--side-ink);padding:22px 14px;position:sticky;top:0;height:100vh;overflow-y:auto}
aside h1{color:#fff;font-size:20px;padding:0 10px 4px}
aside small{display:block;padding:0 10px 18px;color:#8e9ac0}
aside button{display:block;width:100%;text-align:left;background:none;border:0;color:inherit;font:500 14.5px Figtree,system-ui,sans-serif;padding:10px 12px;border-radius:8px;cursor:pointer;margin-bottom:2px}
aside button:hover{background:rgba(255,255,255,.07)}
aside button[aria-selected="true"]{background:var(--brand);color:#fff}
main{padding:26px clamp(14px,3vw,36px) 60px;min-width:0}
.top{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:18px}
.top h2{font-size:24px;flex:1}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-bottom:18px}
.card{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:14px 16px}
.card b{display:block;font:700 28px Sora,Figtree,sans-serif}
.card span{color:var(--mute);font-size:13px}
.card.ok b{color:var(--ok)}.card.bad b{color:var(--bad)}
.panel{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:16px;margin-bottom:16px}
.panel h3{font-size:17px;margin-bottom:12px}
.two{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.floor{display:flex;gap:12px;padding:10px 0;border-top:1px solid var(--line)}
.floor:first-of-type{border-top:0}
.floor>strong{min-width:70px;font:700 14px Sora,sans-serif;padding-top:6px}
.rooms{display:flex;flex-wrap:wrap;gap:8px}
.room{border:1px solid var(--line);border-radius:8px;padding:7px 9px;min-width:92px}
.room small{display:block;color:var(--mute);margin-bottom:4px}
.beds{display:flex;gap:4px;flex-wrap:wrap}
.bed{width:18px;height:18px;border-radius:50%;border:2px solid var(--brand)}
.bed.on{background:var(--brand)}
.legend{display:flex;gap:16px;color:var(--mute);font-size:13px;margin-top:8px}
.legend i{display:inline-block;width:12px;height:12px;border-radius:50%;border:2px solid var(--brand);vertical-align:-1px;margin-right:5px}
.legend i.on{background:var(--brand)}
.bar{height:12px;background:var(--bad-soft);border-radius:6px;overflow:hidden;margin:8px 0}
.bar div{height:100%;background:var(--ok)}
.split{display:flex;justify-content:space-between;color:var(--mute);font-size:13px;gap:8px;flex-wrap:wrap}
.fin{display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px solid var(--line)}
.fin:last-child{border:0;font-weight:700}
.btn{background:var(--brand);color:#fff;border:0;border-radius:8px;padding:9px 14px;font:600 14px Figtree,system-ui,sans-serif;cursor:pointer}
.btn.ghost{background:transparent;color:var(--ink);border:1px solid var(--line)}
.btn.sm{padding:5px 10px;font-size:13px}
.btn.danger{background:transparent;color:var(--bad);border:1px solid var(--bad)}
button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid var(--warn);outline-offset:1px}
input,select,textarea{font:inherit;color:var(--ink);background:var(--bg);border:1px solid var(--line);border-radius:8px;padding:8px 10px;width:100%}
label{display:block;font-size:13px;color:var(--mute);margin-bottom:10px}
label input,label select,label textarea{margin-top:3px}
.wrap{overflow-x:auto}
table{border-collapse:collapse;width:100%;min-width:620px}
th,td{text-align:left;padding:9px 10px;border-bottom:1px solid var(--line);vertical-align:middle}
th{font-size:13px;color:var(--mute);font-weight:600}
.tag{display:inline-block;padding:2px 9px;border-radius:99px;font-size:12.5px;font-weight:600}
.tag.paid,.tag.low,.tag.done,.tag.out{background:var(--ok-soft);color:var(--ok)}
.tag.unpaid,.tag.high{background:var(--bad-soft);color:var(--bad)}
.tag.medium,.tag.open,.tag.in{background:var(--warn-soft);color:#946a00}
.tag.progress{background:var(--brand-soft);color:var(--brand)}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.empty{color:var(--mute);padding:16px 0;text-align:center}
.note{border-left:4px solid var(--warn);background:var(--warn-soft);padding:8px 12px;border-radius:6px;margin-bottom:8px;display:flex;gap:8px;justify-content:space-between;align-items:center}
.filters{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px}
dialog{border:1px solid var(--line);border-radius:14px;background:var(--surface);color:var(--ink);width:min(480px,92vw);padding:20px}
dialog::backdrop{background:rgba(0,0,0,.5)}
dialog h2{margin-bottom:14px;font-size:20px}
.actions{display:flex;gap:8px;justify-content:flex-end;margin-top:6px}
.check{display:flex;gap:8px;align-items:center;color:var(--ink)}.check input{width:auto;margin:0}
.rcpt p{display:flex;justify-content:space-between;margin:6px 0;border-bottom:1px dashed var(--line)}
:root{--bg:#f4f6fb;--brand:#1f4fd8;--brand-soft:#e4ebff;--shadow:0 1px 2px rgba(16,24,40,.05),0 6px 18px rgba(16,24,40,.06)}
.app{grid-template-columns:248px 1fr}
aside{background:linear-gradient(180deg,#0d1a3a,#15275a);padding:20px 12px}
aside h1{display:flex;align-items:center;gap:10px;font-size:18px;padding:0 8px 2px}
aside h1::before{content:"PG";display:grid;place-items:center;width:34px;height:34px;border-radius:10px;background:var(--brand);color:#fff;font:700 13px Sora,sans-serif}
aside small{padding:4px 8px 20px 52px}
aside button{display:flex;align-items:center;gap:11px;padding:10px 12px;border-radius:10px}
aside button[aria-selected="true"]{background:#fff;color:#0d1a3a;font-weight:600}
.ic{width:18px;height:18px;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;flex:none}
main{max-width:1240px;width:100%}
.top{padding-bottom:14px;border-bottom:1px solid var(--line);margin-bottom:20px}
.top h2{font-size:26px}
.sub{color:var(--mute);font-size:13px;font-weight:400}
.card,.panel{box-shadow:var(--shadow);border-radius:14px}
.card{padding:16px 18px;border-top:3px solid var(--brand)}
.card.ok{border-top-color:var(--ok)}.card.bad{border-top-color:var(--bad)}
.panel{padding:20px}
.panel h3{font-size:16px}
table{font-size:14px}
th{background:var(--bg);white-space:nowrap}
th:first-child{border-radius:8px 0 0 8px}th:last-child{border-radius:0 8px 8px 0}
tr:hover td{background:color-mix(in srgb,var(--brand) 5%,transparent)}
.btn{box-shadow:0 1px 2px rgba(16,24,40,.12)}.btn.ghost,.btn.danger{box-shadow:none}
.donuts{display:grid;grid-template-columns:repeat(auto-fit,minmax(190px,1fr));gap:16px}
.donut{display:flex;align-items:center;gap:14px}
.ring{width:86px;height:86px;border-radius:50%;display:grid;place-items:center;flex:none}
.ring span{width:64px;height:64px;border-radius:50%;background:var(--surface);display:grid;place-items:center;font:700 16px Sora,sans-serif}
.donut b{display:block}
.toast{position:fixed;left:50%;bottom:calc(24px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--ink);color:var(--bg);padding:10px 16px;border-radius:10px;z-index:50;display:none;max-width:90vw}
.err{color:var(--bad);background:var(--bad-soft);padding:8px 10px;border-radius:8px;margin:0 0 12px}
.chip{display:inline-flex;align-items:center;gap:2px;background:var(--brand-soft);color:var(--ink);border-radius:99px;padding:2px 4px 2px 10px;margin:2px 4px 2px 0;font-size:13px}
.chip .x{border:0;background:transparent;color:var(--bad);cursor:pointer;font:700 15px/1 Figtree,system-ui,sans-serif;width:22px;height:22px;border-radius:50%}
.chip .x:hover{background:var(--bad-soft)}
.rules{margin:0;padding-left:22px}
.rules li{padding:10px 0 10px 4px;border-bottom:1px solid var(--line)}
.rules li:last-child{border:0}
.rules li>div{display:flex;gap:12px;justify-content:space-between;align-items:flex-start;flex-wrap:wrap}
.rules .rl{white-space:nowrap;display:flex;gap:6px}
.chart{display:flex;gap:18px;align-items:flex-end;height:230px;overflow-x:auto;padding-top:10px}
.col{display:flex;flex-direction:column;align-items:center;height:100%;min-width:60px}
.bars{flex:1;display:flex;align-items:flex-end;gap:5px;justify-content:center;width:100%}
.b{display:block;width:22px;border-radius:4px 4px 0 0}.b.in{background:var(--ok)}.b.out{background:var(--bad)}
.col small{color:var(--mute);margin-top:6px}
.legend i.lg{border:0;border-radius:3px}
.hero{background:linear-gradient(135deg,#0d1a3a,#1f4fd8);color:#fff;border-radius:18px;padding:20px clamp(18px,4vw,44px) 36px}
.hnav{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:48px}
.hnav b{font:700 18px Sora,sans-serif}
.hero h1{font-size:clamp(28px,5vw,46px);line-height:1.12;max-width:720px;margin:0 0 14px}
.hero p{max-width:560px;color:#d3dcf5;font-size:17px;margin:0 0 24px}
.btn.big{padding:13px 22px;font-size:15px}
.hero .btn.ghost{color:#fff;border-color:rgba(255,255,255,.45)}
.hero .btn:not(.ghost){background:#fff;color:#0d1a3a}
.hcta{display:flex;gap:10px;flex-wrap:wrap}
.hstats{display:grid;grid-template-columns:repeat(auto-fit,minmax(130px,1fr));gap:12px;margin-top:36px}
.hstats div{background:rgba(255,255,255,.12);border-radius:12px;padding:12px 14px}
.hstats b{display:block;font:700 26px Sora,sans-serif}
.hstats span{font-size:13px;color:#c9d4f3}
.sec{margin:36px 0 14px}.sec h2{font-size:24px}.sec p{margin:4px 0 0;color:var(--mute)}
.tgrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:14px}
.tcard{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:18px;box-shadow:var(--shadow)}
.tcard h3{font-size:16px}
.price{font:700 28px Sora,sans-serif;margin:6px 0}.price small{font:400 13px Figtree,sans-serif;color:var(--mute)}
.fac{background:var(--surface);border:1px solid var(--line);border-radius:12px;padding:12px 14px}
.fac::before{content:"✓";color:var(--ok);font-weight:700;margin-right:8px}
.sitefoot{text-align:center;color:var(--mute);padding:28px 0 0;font-size:13px}
@media (max-width:820px){
 .app{grid-template-columns:1fr}
 aside{height:auto;position:sticky;top:env(safe-area-inset-top,0px);padding:10px;display:flex;gap:4px;overflow-x:auto;z-index:5}
 aside h1,aside small{display:none}
 aside button{width:auto;white-space:nowrap;margin:0}
 .two,.grid2{grid-template-columns:1fr}
}
@media print{body>*:not(dialog){display:none!important}dialog{border:0;width:100%}.actions{display:none}}
</style>
</head>
<body>
<div class="app">
  <aside><h1 id="brand">PG Manager</h1><small id="mon"></small><div id="nav" role="tablist"></div></aside>
  <main id="view"></main>
</div>
<dialog id="dlg"><form method="dialog" id="dform"></form></dialog>

<script>
const KEY='pg-manager-v2';
const DAYS=['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'];
const TABS=[['home','Website home'],['dash','Dashboard'],['rooms','Floors & rooms'],['members','Members'],['past','Past members'],['rent','Rent & receipts'],['menu','Food menu'],['maint','Maintenance'],['rules','PG rules'],['visitors','Visitors'],['enq','Enquiries'],['exp','Expenses'],['staff','Staff & salary'],['report','Monthly report'],['more','Backup & settings']];
const ICONS={home:'<path d="M3 12l9-9 9 9M5 10v10h14V10"/>',dash:'<rect x="3" y="3" width="7" height="9"/><rect x="14" y="3" width="7" height="5"/><rect x="14" y="12" width="7" height="9"/><rect x="3" y="16" width="7" height="5"/>',rooms:'<path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M9 22V12h6v10"/>',members:'<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>',past:'<circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>',rent:'<rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/>',menu:'<path d="M18 8h1a4 4 0 0 1 0 8h-1M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4z"/>',maint:'<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94z"/>',visitors:'<path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4M10 17l5-5-5-5M15 12H3"/>',enq:'<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',exp:'<path d="M12 1v22M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>',staff:'<rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>',report:'<path d="M18 20V10M12 20V4M6 20v-6"/>',rules:'<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/>',more:'<path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6"/>'};
const ic=k=>`<svg class="ic" viewBox="0 0 24 24" aria-hidden="true">${ICONS[k]}</svg>`;
const uid=()=>Math.random().toString(36).slice(2,9);
const today=()=>new Date().toISOString().slice(0,10);
const esc=s=>String(s==null?'':s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
const inr=n=>'₹'+Number(n||0).toLocaleString('en-IN');
const monthName=()=>new Date().toLocaleString('en-IN',{month:'long',year:'numeric'});

function seed(){
  const rooms=[];
  [[1,[['101',3],['102',2],['103',4]]],[2,[['201',3],['202',3],['203',2]]],[3,[['301',4],['302',2]]]].forEach(([f,rs])=>rs.forEach(([no,beds])=>rooms.push({id:uid(),floor:f,no,beds,type:beds<=2?'AC':'Non-AC',rent:beds>=4?4500:beds===3?5500:6500})));
  const names=['Ravi Kumar','Sneha Reddy','Anil Varma','Priya Sharma','Karthik Rao','Divya Lakshmi','Suresh Babu','Mounika','Harsha Vardhan','Lavanya'];
  const members=[],payments=[];let i=0;const month=monthName();
  rooms.forEach(r=>{const n=Math.max(0,r.beds-(i%3===0?1:0));for(let k=0;k<n&&i<names.length;k++,i++){const m={id:uid(),name:names[i],phone:'98480'+String(10000+i*137).slice(0,5),roomId:r.id,rent:r.rent,deposit:r.rent,paid:i%3!==1,joined:'2026-0'+(1+i%8)+'-05'};members.push(m);if(m.paid)payments.push({id:uid(),memberId:m.id,name:m.name,room:r.no,month,amount:m.rent,date:today(),mode:'UPI'})}});
  const menu={},b=['Idli, sambar','Poha, tea','Dosa, chutney','Upma, banana','Puri, curry','Pongal, vada','Paratha, curd'],l=['Rice, dal, veg curry','Rice, sambar, fry','Veg pulao, raita','Rice, rasam, egg curry','Rice, dal, paneer','Veg biryani, raita','Special meals'],d=['Chapati, kurma','Rice, curd, pickle','Chapati, dal','Fried rice, manchurian','Chapati, aloo curry','Rice, chicken curry','Dosa, chutney'];
  DAYS.forEach((x,j)=>menu[x]=[b[j],l[j],d[j]]);
  return{name:'PG Manager',month,rooms,members,payments,menu,
   tasks:[{id:uid(),room:'102',issue:'Ceiling fan making noise',priority:'medium',status:'open',date:today()},{id:uid(),room:'Common',issue:'Water purifier filter change',priority:'high',status:'in progress',date:today()}],
   visitors:[{id:uid(),name:'Ramesh (father)',to:'Ravi Kumar',date:today(),inTime:'10:30',out:''}],
   expenses:[{id:uid(),cat:'Electricity',amount:9200,date:today(),note:''},{id:uid(),cat:'Groceries',amount:14500,date:today(),note:''}],
   notices:[{id:uid(),text:'Water supply will be off Sunday 10am to 1pm.'}]};
}
function load(){
  try{const r=localStorage.getItem(KEY);if(r)return JSON.parse(r)}catch(e){}
  try{const o=JSON.parse(localStorage.getItem('pg-manager-v1')||'null');if(o){const s=seed();return Object.assign(s,o,{payments:[],visitors:[],expenses:[],notices:[]})}}catch(e){}
  return seed();
}
function save(){try{localStorage.setItem(KEY,JSON.stringify(S))}catch(e){}}
let S=load(),tab='home',filter='all',q='',rentMonth='';

const roomOf=id=>S.rooms.find(r=>r.id===id);
const occ=id=>S.members.filter(m=>m.roomId===id).length;
const sortedRooms=()=>[...S.rooms].sort((a,b)=>a.floor-b.floor||a.no.localeCompare(b.no,undefined,{numeric:true}));
function totals(){
  const beds=S.rooms.reduce((a,r)=>a+Number(r.beds),0),filled=S.members.length;
  const paid=S.members.filter(m=>m.paid),unpaid=S.members.filter(m=>!m.paid);
  const spent=S.expenses.filter(e=>e.month===S.month||(!e.month)).reduce((a,e)=>a+Number(e.amount),0);
  return{floors:new Set(S.rooms.map(r=>r.floor)).size,rooms:S.rooms.length,beds,filled,vacant:beds-filled,paid:paid.length,unpaid:unpaid.length,got:paid.reduce((a,m)=>a+Number(m.rent),0),due:unpaid.reduce((a,m)=>a+Number(m.rent),0),spent};
}
function render(){
  document.getElementById('nav').innerHTML=TABS.map(([k,l])=>`<button role="tab" aria-selected="${k===tab}" data-tab="${k}">${ic(k)}${l}</button>`).join('');
  document.getElementById('brand').textContent=S.name||'PG Manager';document.getElementById('mon').textContent='Rent month: '+S.month;
  document.getElementById('view').innerHTML=({dash,rooms,members,rent,menu,maint,visitors,exp,more,enq,past,rules,report,staff,home})[tab]();
}
const head=(t,btn)=>`<div class="top"><div style="flex:1"><h2>${t}</h2><div class="sub">${new Date().toLocaleDateString('en-IN',{weekday:'long',day:'numeric',month:'long',year:'numeric'})}</div></div>${btn||''}<button class="btn ghost" data-act="theme" aria-label="Switch light or dark theme">Theme</button></div>`;

function dash(){
  const t=totals(),pct=t.paid+t.unpaid?Math.round(t.paid/(t.paid+t.unpaid)*100):0;
  const floors=[...new Set(S.rooms.map(r=>r.floor))].sort((a,b)=>a-b);
  const map=floors.map(f=>`<div class="floor"><strong>Floor ${f}</strong><div class="rooms">${sortedRooms().filter(r=>r.floor===f).map(r=>{const o=occ(r.id);return`<div class="room"><small>${esc(r.no)} · ${o}/${r.beds}</small><div class="beds">${Array.from({length:r.beds},(_,i)=>`<span class="bed ${i<o?'on':''}"></span>`).join('')}</div></div>`}).join('')}</div></div>`).join('')||'<div class="empty">Add floors and rooms to see the bed map.</div>';
  const due=S.members.filter(m=>!m.paid),inside=S.visitors.filter(v=>!v.out).length,open=S.tasks.filter(x=>x.status!=='done').length;
  return head('Dashboard')+`<div class="cards">
  <div class="card"><b>${t.floors}</b><span>Floors</span></div><div class="card"><b>${t.rooms}</b><span>Rooms</span></div>
